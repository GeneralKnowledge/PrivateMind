{
  "schema_version": "2026-10-18",
  "title": "Agent self-model skeleton (layers, needs, routing graph)",
  "maintainer": "executive",
  "mind_layers_doc": "docs/AGENT_MIND_LAYERS.md",
  "operator_note": "Empty arrays are intentional. The agent extends needs, graph nodes/edges, and routing_policies; operators set the floor via policy and vault, not by editing this graph for the agent.",
  "layers": [
    {
      "id": "needs",
      "aliases": ["subconscious", "id"],
      "description": "Persistent drives and capability pain when resources are missing or fragile.",
