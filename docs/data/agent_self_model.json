        "privatemind research capability-gaps",
        "limitation_log",
        "failed API probes",
        "donor worker health"
      ],
      "feeds_into": ["research_priority", "assistance_requests", "needs[] below"]
    },
    {
      "id": "executive",
      "aliases": ["ego"],
      "description": "Task planning, scheduling, and choosing which service/worker/key path to use.",
      "feeds_from": ["needs", "graph.nodes", "graph.edges", "routing_policies"],
      "feeds_into": ["tasks", "worker_jobs", "draft_prs", "updated graph"]
    },
    {
      "id": "floor",
      "aliases": ["superego"],
      "description": "Non-negotiable boundaries: vault, verification, no auto-merge to main, ToS, never_automate.",
      "feeds_from": [
        "docs/GRADUATED_AUTONOMY.md",
        "docs/THREAT_MODEL.md",
        "agent_capability_domains.never_automate"
      ],
      "feeds_into": ["rejections", "quarantine", "forbidden edges in graph"]
    }
  ],
