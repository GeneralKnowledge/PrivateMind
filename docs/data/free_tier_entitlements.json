{
  "schema_version": "2026-10-18",
  "catalog_title": "Free LLM API entitlements (October 2026)",
  "methodology": {
    "rules": [
      "Permanent free access: no expiring trial credits as the primary entitlement.",
      "Real API access: HTTP from a Python router, not website-only chat.",
      "Direct access: calls go to provider or declared aggregator endpoints, never via GitHub.",
      "Published limits recorded separately from conservative enforced limits for routing.",
      "UK developer: note region, verification, card requirements, commercial restrictions.",
      "Do not classify as Category A without API entitlement verification and a last_verified date."
    ],
    "eligibility_class": {
      "A": "Permanent free API — ongoing inference without expiring credit balance as the main offer.",
      "B": "Free with restrictions — trial keys, non-commercial, model-scoped, card-linked tiers, or weak docs.",
      "C": "Worth investigating — aggregators, unclear quotas, conflicting official pages, or probe-required."
    },
    "free_tier_status_values": [
      "permanent_free_tier",
      "selected_models_free",
      "daily_allowance",
      "neuron_budget",
      "trial_non_commercial",
      "payment_method_required",
      "aggregator_free_pool",
      "retired",
      "unverified"
    ]
  },
